# Default execution environment for workers
ENVIRONMENT_NAME=CHANGE_ME

# Sanitize liquid.py input
LIQUID_SANITIZE_INPUT=CHANGE_ME


# Remote github config for first load
SHUFFLE_DOWNLOAD_WORKFLOW_LOCATION=CHANGE_ME
SHUFFLE_DOWNLOAD_WORKFLOW_USERNAME=CHANGE_ME
SHUFFLE_DOWNLOAD_WORKFLOW_PASSWORD=CHANGE_ME
SHUFFLE_DOWNLOAD_WORKFLOW_BRANCH=CHANGE_ME

SHUFFLE_APP_DOWNLOAD_LOCATION=CHANGE_ME
SHUFFLE_DOWNLOAD_AUTH_USERNAME=CHANGE_ME
SHUFFLE_DOWNLOAD_AUTH_PASSWORD=CHANGE_ME
SHUFFLE_DOWNLOAD_AUTH_BRANCH=CHANGE_ME
SHUFFLE_APP_FORCE_UPDATE=CHANGE_ME

# User config for first load. Username & PW: min length 3
SHUFFLE_DEFAULT_USERNAME=CHANGE_ME
SHUFFLE_DEFAULT_PASSWORD=CHANGE_ME
SHUFFLE_DEFAULT_APIKEY=CHANGE_ME

# Local location of your app directory. Can't use ~/
# Files will get better at some point. Right now: local saving.
SHUFFLE_APP_HOTLOAD_FOLDER=CHANGE_ME
SHUFFLE_APP_HOTLOAD_LOCATION=CHANGE_ME
SHUFFLE_FILE_LOCATION=CHANGE_ME

# Encryption modifier. This HAS to be set to encrypt any authentication being used in Shuffle. This is put together with other relevant values to ensure multiple parts are needed to decrypt. 
# If this key is lost or changed, you will have to reauthenticate all apps.
SHUFFLE_ENCRYPTION_MODIFIER=CHANGE_ME

# Other configs
BASE_URL=CHANGE_ME
SSO_REDIRECT_URL=CHANGE_ME
BACKEND_HOSTNAME=CHANGE_ME
BACKEND_PORT=CHANGE_ME
FRONTEND_PORT=CHANGE_ME
FRONTEND_PORT_HTTPS=CHANGE_ME
AUTH_FOR_ORBORUS=CHANGE_ME

# CHANGE THIS IF YOU WANT GOOD LOCAL EXECUTIONS:
OUTER_HOSTNAME=CHANGE_ME
DB_LOCATION=CHANGE_ME
DOCKER_API_VERSION=CHANGE_ME

# Orborus/Proxy configurations  
HTTP_PROXY=CHANGE_ME
HTTPS_PROXY=CHANGE_ME
SHUFFLE_PASS_WORKER_PROXY=CHANGE_ME
SHUFFLE_PASS_APP_PROXY=CHANGE_ME
SHUFFLE_INTERNAL_HTTP_PROXY=CHANGE_ME
SHUFFLE_INTERNAL_HTTPS_PROXY=CHANGE_ME
# Timezone-handler in Orborus, Worker and Apps
TZ=CHANGE_ME
# Used to FIND the containername. cgroup v2: issue 501
ORBORUS_CONTAINER_NAME=CHANGE_ME
# Used for setting up a startup delay for Orborus
SHUFFLE_ORBORUS_STARTUP_DELAY=CHANGE_ME
SHUFFLE_SKIPSSL_VERIFY=CHANGE_ME
# Used for controlling if the environment should run in kubernetes or not
IS_KUBERNETES=CHANGE_ME

#SHUFFLE_BASE_IMAGE_NAME=shuffle
#SHUFFLE_BASE_IMAGE_REGISTRY=ghcr.io
SHUFFLE_BASE_IMAGE_REPOSITORY=CHANGE_ME
#SHUFFLE_BASE_IMAGE_TAG_SUFFIX="-1.4.0"

# For environments using their own docker registry
# where they don't want to update http, subflow and shuffle tools again
SHUFFLE_USE_GCHR_OVERRIDE_FOR_AUTODEPLOY=CHANGE_ME

# The eth0 interface inside a container corresponds 
# to the virtual Ethernet interface that connects 
# the container to the docker0 
SHUFFLE_SWARM_BRIDGE_DEFAULT_INTERFACE=CHANGE_ME
# 1500 by default
SHUFFLE_SWARM_BRIDGE_DEFAULT_MTU=CHANGE_ME

# Used for auto-cleanup of containers. REALLY important at scale. Set to false to see all container info.
SHUFFLE_MEMCACHED=CHANGE_ME
SHUFFLE_CONTAINER_AUTO_CLEANUP=CHANGE_ME
# The amount of concurrent executions Orborus can handle. This is a soft limit, but it's recommended to keep it low.
SHUFFLE_ORBORUS_EXECUTION_CONCURRENCY=CHANGE_ME
SHUFFLE_HEALTHCHECK_DISABLED=CHANGE_ME
SHUFFLE_ELASTIC=CHANGE_ME
SHUFFLE_CHAT_DISABLED=CHANGE_ME
SHUFFLE_DISABLE_RERUN_AND_ABORT=CHANGE_ME
SHUFFLE_RERUN_SCHEDULE=CHANGE_ME
# Definition in case Worker & Orborus is talking to the wrong server
SHUFFLE_WORKER_SERVER_URL=CHANGE_ME
# Definition in case Orborus is pulling too often/not often enough
SHUFFLE_ORBORUS_PULL_TIME=CHANGE_ME
# Max recursion depth for subflows
SHUFFLE_MAX_EXECUTION_DEPTH=CHANGE_ME

# DATABASE CONFIGURATIONS
DATASTORE_EMULATOR_HOST=CHANGE_ME
SHUFFLE_OPENSEARCH_URL=CHANGE_ME
SHUFFLE_OPENSEARCH_CERTIFICATE_FILE=CHANGE_ME
SHUFFLE_OPENSEARCH_APIKEY=CHANGE_ME
SHUFFLE_OPENSEARCH_CLOUDID=CHANGE_ME
SHUFFLE_OPENSEARCH_PROXY=CHANGE_ME
SHUFFLE_OPENSEARCH_INDEX_PREFIX=CHANGE_ME
SHUFFLE_OPENSEARCH_SKIPSSL_VERIFY=CHANGE_ME
SHUFFLE_OPENSEARCH_USERNAME=CHANGE_ME
SHUFFLE_OPENSEARCH_PASSWORD=CHANGE_ME
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME

#Tenzir related 
SHUFFLE_TENZIR_URL=CHANGE_ME


DEBUG_MODE=CHANGE_ME


SHUFFLE_APP_SDK_TIMEOUT=CHANGE_ME
SHUFFLE_ORBORUS_EXECUTION_CONCURRENCY=CHANGE_ME
ORG_ID=CHANGE_ME
SHUFFLE_STATS_DISABLED=CHANGE_ME
SHUFFLE_LOGS_DISABLED=CHANGE_ME
SHUFFLE_SWARM_CONFIG=CHANGE_ME
CLEANUP=CHANGE_ME
SHUFFLE_WORKER_IMAGE=CHANGE_ME
